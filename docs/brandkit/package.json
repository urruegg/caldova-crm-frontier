    "./design-tokens.json": "./tokens/design-tokens.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.46.0",
    "react": "^16.14.0 || ^17 || ^18",
    "react-dom": "^16.14.0 || ^17 || ^18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
