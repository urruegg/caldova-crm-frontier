{
  "name": "@caldova/fluent-brandkit",
  "version": "0.1.0",
  "description": "Caldova Fluent UI v9 brand kit — themes, tokens and components for React apps and Power Apps PCF controls",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": ["*.css"],
