<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="Caldova" constructor="CaldovaCard"
           version="1.0.0" display-name-key="CaldovaCard"
           description-key="Caldova-branded card built on the Fluent brand kit"
           control-type="virtual">

    <property name="title"   display-name-key="Title"   of-type="SingleLine.Text" usage="bound"  required="true" />
    <property name="value"   display-name-key="Value"   of-type="SingleLine.Text" usage="bound"  required="true" />
    <property name="caption" display-name-key="Caption" of-type="SingleLine.Text" usage="input"  required="false" />
    <property name="status"  display-name-key="Status"  of-type="SingleLine.Text" usage="input"  required="false" />
    <property name="acknowledged" display-name-key="Acknowledged"
              of-type="TwoOptions" usage="bound" required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <!-- Virtual control: React and Fluent come from the platform. Do NOT
           bundle your own copies — two Fluent instances means two style
           registries writing to the same document. -->
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <feature-usage>
      <!-- Required for context.fluentDesignLanguage (host theme bridging). -->
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
